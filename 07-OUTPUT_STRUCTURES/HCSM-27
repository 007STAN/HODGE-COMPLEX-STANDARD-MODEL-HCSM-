@article{PreschuttiHCSM27,
  author = {Preschutti, Stanley},
  title = {{HCSM-27}: Klein Orbit Structure},
  journal = {HCSM White Paper Series},
  year = {2026},
  month = {September},
  note = {ORCID: 0009-0004-5445-1744},
  keywords = {Hodge Complex Standard Model, HCSM, Klein four-group,
    dihedral group, orbit structure, four-cycle orbit, framework
    constant, pointwise stabilizer, swap-pair bridge},
  abstract = {This paper characterizes the Klein orbit structure of the
    fourteen-mode multiplet in the Hodge Complex Standard Model. The
    Klein four-group generated by the diagonal reflection and the
    half-period translation acts on the multiplet with orbit
    decomposition consisting of five two-cycle orbits and one four-cycle
    orbit. The four-cycle orbit's four mass-ordering labels are all
    framework constants, with sum fifty-six, the dimension of the Hodge
    sector at the self-paired eigenvalue.}
